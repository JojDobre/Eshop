# Konfigurácia e-shopu.
# Pri inštalácii na webhosting sa tento súbor skopíruje do .env automaticky
# a webový inštalátor doplní údaje k databáze a adresu obchodu.

APP_NAME=E-shop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

# Súbory namiesto databázy: menej dotazov a funguje aj pred inštaláciou.
SESSION_DRIVER=file
# Pevný názov cookie: nemení sa pri zmene názvu obchodu (inak by sa používatelia odhlásili).
SESSION_COOKIE=eshop_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
SETTINGS_CACHE_ENABLED=true

FILESYSTEM_DISK=local
# Úlohy na pozadí sa zatiaľ vykonávajú hneď. Fronta cez cron pribudne s e-mailmi.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# Záchranný režim: načítajú sa iba základné moduly (pozri dokumentáciu).
ESHOP_SAFE_MODE=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
