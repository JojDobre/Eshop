{
    "name": "butik",
    "version": "1.0.0",
    "title": {
        "sk": "Butik",
        "cs": "Butik",
        "en": "Butik"
    },
    "description": {
        "sk": "Odvážna módna šablóna v štýle magazínu: veľké fotky, úzke verzálky, štyri palety. Novinky so záložkami, druhá fotka pri prejdení myšou, farby a veľkosti na karte, shop the look, lookbook a Instagram. S hotovým demom.",
        "cs": "Odvážná módní šablona ve stylu magazínu: velké fotky, úzké verzálky, čtyři palety. Novinky se záložkami, druhá fotka při najetí myší, barvy a velikosti na kartě, shop the look, lookbook a Instagram. S hotovým demem.",
        "en": "A bold editorial fashion theme: large photos, condensed capitals, four palettes. New arrivals with tabs, second photo on hover, colours and sizes on cards, shop the look, lookbook and Instagram. Includes a demo."
    },
    "author": "E-shop",
    "parent": "default",
    "screenshot": "screenshot.jpg",
    "requires": {
        "eshop": "^1.10"
    },
    "vite": [
        "themes/butik/assets/css/theme.css",
        "themes/default/assets/js/theme.js"
    ],
    "hide_settings": [
        "font",
        "header_layout",
        "announcement",
        "button_style",
        "show_tagline"
    ],
