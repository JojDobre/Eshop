{
    "name": "dielna",
    "version": "1.0.0",
    "title": {
        "sk": "Dielňa",
        "cs": "Dílna",
        "en": "Workshop"
    },
    "description": {
        "sk": "Teplá šablóna pre handmade a remeselné obchody: úvod s fotkou v oblúku, kategórie podľa remesla, príbeh tvorcu, postup výroby, formulár na výrobu na mieru, recenzie a galéria. S hotovým demom (keramika, sviečky, šperky).",
        "cs": "Teplá šablona pro handmade a řemeslné obchody: úvod s fotkou v oblouku, kategorie podle řemesla, příběh tvůrce, postup výroby, formulář na výrobu na míru, recenze a galerie. S hotovým demem (keramika, svíčky, šperky).",
        "en": "A warm theme for handmade and craft shops: hero with an arched photo, categories by craft, maker story, making process, made-to-order form, reviews and gallery. Includes a ready demo (ceramics, candles, jewellery)."
    },
    "author": "E-shop",
    "parent": "default",
    "screenshot": "screenshot.jpg",
    "requires": {
        "eshop": "^1.6"
    },
    "vite": [
        "themes/dielna/assets/css/theme.css",
        "themes/default/assets/js/theme.js"
    ],
    "hide_settings": [
        "font",
        "header_layout",
        "announcement",
        "button_style",
        "show_tagline"
    ],
