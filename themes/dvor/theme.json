{
    "name": "dvor",
    "version": "1.0.0",
    "title": {
        "sk": "Dvor",
        "cs": "Dvůr",
        "en": "Dvor"
    },
    "description": {
        "sk": "Živá šablóna pre farmy a predaj farmárskych produktov: fotky v tvare vajíčka, kategórie v tvare stodoly, dni rozvozu, produkty s balením a cenovkou, týždenná debnička, adopcia zvieratiek, pozvánka na farmu a príbeh farmy. Päť paliet vrátane tmavej. S hotovým demom.",
        "cs": "Živá šablona pro farmy a prodej farmářských produktů: fotky ve tvaru vajíčka, kategorie ve tvaru stodoly, dny rozvozu, produkty s balením a cenovkou, týdenní bedýnka, adopce zvířátek, pozvánka na farmu a příběh farmy. Pět palet včetně tmavé. S hotovým demem.",
        "en": "A lively theme for farms and farm produce: egg-shaped photos, barn-shaped categories, delivery days, products with pack size and price tag, a weekly box, animal adoption, a farm event and the farm story. Five palettes including a dark one. Includes a demo."
    },
    "author": "E-shop",
    "parent": "default",
    "screenshot": "screenshot.jpg",
    "requires": {
        "eshop": "^1.13"
    },
    "vite": [
        "themes/dvor/assets/css/theme.css",
        "themes/default/assets/js/theme.js"
    ],
