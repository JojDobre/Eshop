    "title": {
        "sk": "Farma",
        "cs": "Farma",
        "en": "Farm"
    },
    "description": {
        "sk": "Priateľská šablóna pre malé obchody s domácimi produktmi: oznam v hornom pruhu, veľký baner, kategórie v dlaždiciach, čisté karty produktov, sekcia o farme, hodnotenia a časté otázky.",
        "cs": "Přátelská šablona pro malé obchody s domácími produkty: oznámení v horním pruhu, velký banner, kategorie v dlaždicích, čisté karty produktů, sekce o farmě, hodnocení a časté dotazy.",
        "en": "A friendly theme for small shops with home-made products: top bar notice, large banner, category tiles, clean product cards, about section, reviews and FAQ."
    },
    "author": "E-shop",
    "parent": "default",
    "screenshot": "screenshot.jpg",
    "requires": {
        "eshop": "^1.0"
    },
    "vite": [
        "themes/farma/assets/css/theme.css",
        "themes/default/assets/js/theme.js"
    ],
    "hide_settings": [
        "announcement",
        "button_style",
        "show_tagline"
    ],
