{
    "name": "kapitola",
    "version": "1.0.0",
    "title": {
        "sk": "Kapitola",
        "cs": "Kapitola",
        "en": "Kapitola"
    },
    "description": {
        "sk": "Útulná šablóna pre kníhkupectvá, papiernictvá a predaj e-kníh: úvod s fotkou a knihou mesiaca, polička bestsellerov, nové vydania, fotky s náladou, e-knihy na stiahnutie, papiernictvo a odporúčania kníhkupcov. Štyri palety vrátane tmavej. S hotovým demom.",
        "cs": "Útulná šablona pro knihkupectví, papírnictví a prodej e-knih: úvod s fotkou a knihou měsíce, polička bestsellerů, nová vydání, fotky s náladou, e-knihy ke stažení, papírnictví a doporučení knihkupců. Čtyři palety včetně tmavé. S hotovým demem.",
        "en": "A cosy theme for bookshops, stationers and e-book sellers: photo hero with book of the month, bestseller shelf, new releases, mood photos, downloadable e-books, stationery and staff picks. Four palettes including a dark one. Includes a demo."
    },
    "author": "E-shop",
    "parent": "default",
    "screenshot": "screenshot.jpg",
    "requires": {
        "eshop": "^1.12"
    },
    "vite": [
        "themes/kapitola/assets/css/theme.css",
        "themes/default/assets/js/theme.js"
    ],
    "hide_settings": [
        "font",
        "header_layout",
        "announcement",
        "button_style",
        "show_tagline"
    ],
