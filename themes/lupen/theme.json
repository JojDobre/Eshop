{
    "name": "lupen",
    "version": "1.0.0",
    "title": {
        "sk": "Lupeň",
        "cs": "Lupen",
        "en": "Lupeň"
    },
    "description": {
        "sk": "Svieža šablóna pre kvetinárstva: doručenie ešte dnes s odpočtom, príležitosti, kytice s veľkosťami priamo na karte, predplatné, rastliny a recenzie s fotkami. Tvar lupeňa, štyri palety vrátane tmavej. S hotovým demom.",
        "cs": "Svěží šablona pro květinářství: doručení ještě dnes s odpočtem, příležitosti, kytice s velikostmi přímo na kartě, předplatné, rostliny a recenze s fotkami. Tvar okvětního lístku, čtyři palety včetně tmavé. S hotovým demem.",
        "en": "A fresh theme for florists: same-day delivery with a countdown, occasions, bouquets with sizes on the card, subscription, plants and photo reviews. Petal shapes and four palettes including a dark one. Includes a demo."
    },
    "author": "E-shop",
    "parent": "default",
    "screenshot": "screenshot.jpg",
    "requires": {
        "eshop": "^1.11"
    },
    "vite": [
        "themes/lupen/assets/css/theme.css",
        "themes/default/assets/js/theme.js"
    ],
